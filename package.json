{
  "name": "cleaning-panel",
  "version": "1.3.0",
  "description": "Care operations by client and location, durable Time Clock, payroll and housekeeping",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js",
    "test:core": "node test/roomEngine.test.js",
    "check:core": "node --check core/rooms/RoomEngine.js && node --check test/roomEngine.test.js",
    "test:payroll": "node test/payroll.test.js && node test/payrollExcel.test.js",
    "test:control": "node test/controlCenter.test.js",
    "test:reliability": "node test/reliability.test.js && node test/eventReliability.test.js && node test/payrollReliability.test.js",
    "verify": "node scripts/verify.js",
    "test:directory": "node test/clientDirectory.test.js",
    "test:directory:db": "node test/clientDirectoryDb.test.js",
    "test:work": "node test/workClockMirror.test.js",
    "test:work:db": "node test/scopedWorkDb.test.js",
    "test:rates:db": "node test/serviceRatesDb.test.js",
    "test:notion:db": "node test/notionWorkDb.test.js",
    "test:access": "node test/accessGuard.test.js && node test/accessActivity.test.js"
  },
  "author": "Andres Garcia",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.0",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.7.5",
    "pg": "^8.16.3",
    "firebase-admin": "^13.4.0",
    "compression": "^1.7.5",
    "web-push": "^3.6.7"
  }
}
